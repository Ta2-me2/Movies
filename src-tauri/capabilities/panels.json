{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "panels",
  "description": "Capability for the About and Settings windows",
  "windows": [
    "about",
    "settings"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-size",
    "core:window:allow-center",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:default"
  ]
}
